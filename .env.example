# ─────────────────────────────────────────────
# CodeSense — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────


# ── Groq ──────────────────────────────────────
# Used for: LLM generation + query classification (via Groq's
# OpenAI-compatible endpoint)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# Any chat model from https://console.groq.com/docs/models
# (llama-3.1-70b-versatile, the original target, has been decommissioned)
GROQ_MODEL=openai/gpt-oss-120b

# Groq rate limit handling — free tier is ~30 req/min
# tenacity will retry on 429s with this delay (seconds)
GROQ_RETRY_DELAY=2
GROQ_MAX_RETRIES=3


# ── GitHub ────────────────────────────────────
# Used for: repo metadata via PyGithub, authenticated cloning
# Create at: https://github.com/settings/tokens
# Public repos need no scopes. For private repos, use a fine-grained token
# with read-only "Contents" + "Metadata" access — never a write-capable token.
GITHUB_TOKEN=ghp_...


# ── Qdrant ────────────────────────────────────
# Used for: vector storage and filtered ANN search
# If running locally via Docker: defaults below work out of the box
# If using Qdrant Cloud: replace host with your cluster URL + add API key
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Leave empty for local Docker instance
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=codesense # Collections named: codesense_{owner}_{repo}


# ── Redis ─────────────────────────────────────
# Used for: Celery broker/result backend, repo metadata, rate limiting
# REDIS_PORT is also the HOST port docker-compose.yml publishes Redis on —
# change all four 6379s below together if 6379 is taken on your machine.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Leave empty for local Docker instance
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0


# ── Celery ────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ── Embedding Models ──────────────────────────
# bge-small-en-v1.5 is used for semantic embeddings (local inference, no API
# needed). See embeddings/code_embedder.py's module docstring for why this
# replaced microsoft/codebert-base (measured retrieval quality, not a guess).
# Downloaded once on first run, cached to TRANSFORMERS_CACHE
CODEBERT_MODEL_NAME=BAAI/bge-small-en-v1.5
TRANSFORMERS_CACHE=./.model_cache

# Embedding dimensions (do not change unless you swap models — must match
# the configured model's actual output dim)
SEMANTIC_EMBEDDING_DIM=384         # bge-small-en-v1.5 output dim
STRUCTURAL_EMBEDDING_DIM=128       # node2vec output dim


# ── Retrieval Settings ────────────────────────
# Below this cosine similarity, the system refuses to answer.
# Calibrated for bge-small-en-v1.5 — see config.py for the measured numbers
# behind this value (re-measure if you change the embedding model).
RETRIEVAL_CONFIDENCE_THRESHOLD=0.5

# Candidates fetched from Qdrant before re-ranking
RETRIEVAL_TOP_K=30

# Final results passed to generation after re-ranking
RERANKER_TOP_N=5

# Hybrid score weights — must sum to 1.0
# 0.7/0.3 gave the best Precision@5 in our experiments
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_STRUCTURAL_WEIGHT=0.3


# ── Re-ranker ─────────────────────────────────
# Free cross-encoder — no API key needed, runs locally
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2


# ── Ingestion Settings ────────────────────────
REPO_CLONE_DIR=./cloned_repos
INGESTION_WARN_THRESHOLD=50000
INGESTION_MAX_FILES=100000
# Comma-separated extensions to skip
INGESTION_SKIP_EXTENSIONS=.min.js,.min.css,.lock,.sum,.mod


# ── FastAPI Backend ───────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true                # Set false in production
RATE_LIMIT_PER_MINUTE=30
# Comma-separated browser origins allowed to call the API (the Vite dev
# server by default). Set to your deployed frontend URL in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true ONLY when running behind a reverse proxy that sets
# X-Forwarded-For — otherwise clients can spoof it to dodge rate limiting.
TRUST_PROXY_HEADERS=false


# ── Logging ───────────────────────────────────
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_FILE=./logs/codesense.log


# ── Environment ───────────────────────────────
ENVIRONMENT=development            # development | production
